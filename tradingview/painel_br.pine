//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Painel B&R · tendência do modelo e horários
// Mostra, num quadro pequeno no canto (fora dos candles):
//   • tendência do 4H, 1H e 15m pela mesma regra do robô
//     (último fechamento acima/abaixo da média de 60 candles ± 0,3 ATR e acima/abaixo de 60 candles atrás);
//   • a direção que o modelo permite (a do 4H; se o 4H estiver lateral, a do 1H);
//   • a sessão atual e a janela sem entrada das 10h às 11h (Brasília), sombreada de leve;
//   • ATR do 15m e o lote que cabe nos US$ 2 com o stop mínimo do modelo (1,5 ATR).
// Usa só candles fechados dos tempos maiores: não muda depois que o candle fecha.
// Alerta opcional: quando a direção permitida muda.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Painel B&R", overlay = true)

risco    = input.float(2.0, "Risco por operação (US$)", minval = 0.1, step = 0.5)
sombra   = input.bool(true, "Sombrear 10h–11h (sem entrada em dia de dado dos EUA)")
valorMan = input.float(0.0, "Valor de 1,0 de preço por lote em US$ (0 = automático)", minval = 0.0)
tamanho  = input.string("Pequeno", "Tamanho do quadro", options = ["Pequeno", "Normal"])

// tendência pela regra do robô: 1 alta, -1 baixa, 0 lateral
tend() =>
    a = ta.sma(ta.tr(true), 14)
    m = ta.sma(close, 60)
    close > m + 0.3 * a and close > close[59] ? 1 : close < m - 0.3 * a and close < close[59] ? -1 : 0

t4  = request.security(syminfo.tickerid, "240", tend()[1], lookahead = barmerge.lookahead_on)
t1  = request.security(syminfo.tickerid, "60",  tend()[1], lookahead = barmerge.lookahead_on)
t15 = request.security(syminfo.tickerid, "15",  tend()[1], lookahead = barmerge.lookahead_on)
atr15 = request.security(syminfo.tickerid, "15", ta.sma(ta.tr(true), 14)[1], lookahead = barmerge.lookahead_on)

ref = t4 != 0 ? t4 : t1
direcao = ref == 1 ? "só COMPRA" : ref == -1 ? "só VENDA" : "nenhuma (4H e 1H laterais)"

// valor de 1,0 de preço por 1 lote, em US$ (mesma tabela do robô)
tk = syminfo.ticker
valorAuto = str.contains(tk, "XAU") ? 100.0 : str.contains(tk, "US500") or str.contains(tk, "SPX") ? 1.0 : str.endswith(tk, "JPY") ? 100000.0 / close : str.endswith(tk, "USD") ? 100000.0 : na
valor = valorMan > 0 ? valorMan : valorAuto
loteMin = na(valor) or na(atr15) ? na : math.floor(risco / (1.5 * atr15 * valor) * 100) / 100

// horários em Brasília
hb  = hour(time, "America/Sao_Paulo") + minute(time, "America/Sao_Paulo") / 60.0
dia = dayofweek(time, "America/Sao_Paulo")
util = dia != dayofweek.saturday and dia != dayofweek.sunday
indice = str.contains(tk, "US500") or str.contains(tk, "SPX")
janela = util and hb >= 10 and hb < 11
sessao = not util ? "fim de semana" : indice ? (hb >= 11.75 and hb < 18 ? "pregão dos EUA" : "fora do pregão") : hb >= 10 and hb < 14 ? "Londres + Nova York" : hb >= 5 and hb < 10 ? "Londres" : hb >= 14 and hb < 19 ? "Nova York" : "fora do horário"
podeOperar = util and not janela and (indice ? hb >= 11.75 and hb < 18 : hb >= 5 and hb < 19)

bgcolor(sombra and janela ? color.new(color.orange, 88) : na, title = "Janela 10h–11h")

txt(v) => v == 1 ? "alta" : v == -1 ? "baixa" : "lateral"
cor(v) => v == 1 ? color.new(#39ff8c, 0) : v == -1 ? color.new(#ff40a0, 0) : color.new(#9aa0b4, 0)

var table q = table.new(position.top_right, 2, 7, bgcolor = color.new(#0b0d18, 15), border_color = color.new(#1f2547, 0), border_width = 1)
if barstate.islast
    ts = tamanho == "Pequeno" ? size.small : size.normal
    table.cell(q, 0, 0, "Painel B&R", text_color = color.new(#ffd60a, 0), text_size = ts)
    table.cell(q, 1, 0, syminfo.ticker, text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 0, 1, "4H", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 1, txt(t4), text_color = cor(t4), text_size = ts)
    table.cell(q, 0, 2, "1H", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 2, txt(t1), text_color = cor(t1), text_size = ts)
    table.cell(q, 0, 3, "15m", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 3, txt(t15), text_color = cor(t15), text_size = ts)
    table.cell(q, 0, 4, "Direção", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 4, direcao, text_color = cor(ref), text_size = ts)
    table.cell(q, 0, 5, "Agora", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 5, sessao + (janela ? " · 10h–11h: sem entrada" : podeOperar ? " · pode operar" : ""), text_color = podeOperar ? color.new(#39ff8c, 0) : color.new(#ff9640, 0), text_size = ts)
    table.cell(q, 0, 6, "ATR 15m", text_color = color.new(#d9e2ff, 0), text_size = ts)
    table.cell(q, 1, 6, str.tostring(atr15, format.mintick) + (na(loteMin) ? "" : " · lote máx. c/ stop 1,5 ATR: " + str.tostring(loteMin, "#.##")), text_color = color.new(#d9e2ff, 0), text_size = ts)

// alerta quando a direção permitida muda (crie com "Qualquer chamada da função alert()")
if barstate.isconfirmed and ref != ref[1] and not na(ref[1])
    alert(syminfo.ticker + ": a direção do modelo mudou para " + direcao + " (4H " + txt(t4) + ", 1H " + txt(t1) + ")", alert.freq_once_per_bar_close)
